<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>Batch.Shared.ScriptHost</RootNamespace>
    <AssemblyName>Batch.Shared.ScriptHost</AssemblyName>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Common\GlobalAssemblyInfo.cs" Link="Properties\GlobalAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IronPython" Version="2.7.12" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="IronPython" Version="3.4.2" Condition="'$(TargetFramework)' != 'net48'" ExcludeAssets="compile" />
    <PackageReference Include="IronPython.StdLib" Version="3.4.2" Condition="'$(TargetFramework)' != 'net48'" ExcludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Reference Include="IronPython">
      <HintPath>$(NuGetPackageRoot)ironpython\3.4.2\lib\net8.0\IronPython.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Dynamic">
      <HintPath>$(NuGetPackageRoot)dynamiclanguageruntime\1.3.5\lib\net8.0\Microsoft.Dynamic.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Scripting">
      <HintPath>$(NuGetPackageRoot)dynamiclanguageruntime\1.3.5\lib\net8.0\Microsoft.Scripting.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Scripting.Metadata">
      <HintPath>$(NuGetPackageRoot)dynamiclanguageruntime\1.3.5\lib\net8.0\Microsoft.Scripting.Metadata.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.CSharp" />
    <EmbeddedResource Include="Resources\python_27_lib.zip" />
  </ItemGroup>

</Project>
